# Salin ke .env (lokal) atau ~/.env-production (VPS), lalu isi semua nilai.
NGROK_AUTHTOKEN=

# python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# Harus sama dengan EDGE_DEVICE_TOKEN di .env Jetson.
# python -c "import secrets;print(secrets.token_urlsafe(32))"
EDGE_DEVICE_TOKEN=
# Isi false selama transisi kalau VPS di-deploy lebih dulu dari Jetson.
EDGE_TOKEN_REQUIRED=true

# Password Postgres. Di VPS: jalankan ALTER USER dulu, baru isi nilai ini.
# docker exec -it mikroskop_postgres psql -U postgres -c "ALTER USER postgres PASSWORD '<baru>';"
POSTGRES_PASSWORD=
